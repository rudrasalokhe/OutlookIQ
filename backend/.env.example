# OutlookIQ Environment Configuration Example
# Copy this file to .env and configure your local or cloud credentials.

# Database
DATABASE_URL=sqlite:///./backend/storage/outlookiq.db

# LLM Provider Configuration ("grok", "groq", "gemini", "openai", or "local")
LLM_PROVIDER=grok
GROK_API_KEY=your_xai_grok_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=grok-beta

# Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Persistent Storage
CHROMA_PERSIST_DIRECTORY=./backend/storage/chroma

# SEC EDGAR Integration (Format: Sample Company Name AdminContact@domain.com)
SEC_USER_AGENT=OutlookIQResearch research@outlookiq.internal

# Frontend Development Origin
FRONTEND_ORIGIN=http://localhost:3000
